<?xml version="1.0" encoding="utf-8"?>
<!-- Заставка при запуске: фон приложения и иконка по центру. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/vector_background" />
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/vector_green" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/ic_splash_arrow" />
</layer-list>
